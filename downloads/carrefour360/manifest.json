{
  "manifest_version": 3,
  "name": "A4 Studio - Conector de precios",
  "version": "1.0.4",
  "description": "Consulta productos y PVP de Carrefour360 e imágenes del catálogo Carrefour para A4 Studio.",
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://carrefour360.carrefour.com.ar/*",
    "https://claufrias.github.io/a4studio/*",
    "http://localhost/a4studio/*",
    "http://127.0.0.1/a4studio/*",
    "https://www.carrefour.com.ar/*",
    "https://carrefourar.vteximg.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claufrias.github.io/a4studio/*",
        "http://localhost/a4studio/*",
        "http://127.0.0.1/a4studio/*"
      ],
      "js": ["a4-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://carrefour360.carrefour.com.ar/pricing*"],
      "js": ["pricing-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
